# Web için varsayılan: http://localhost:3006/api
# Fiziksel iOS/Android cihazda localhost telefonu gösterir; bilgisayarın LAN IP adresini kullanın.
# Örnek: EXPO_PUBLIC_API_URL=http://192.168.1.25:3006/api
EXPO_PUBLIC_API_URL=http://localhost:3006/api

# Mobil Expo Go bağlantısında API portu (varsayılan 3006)
EXPO_PUBLIC_API_PORT=3006

# API sunucusu
CMMS_PORT=3006
# CMMS_DB_PATH=server/data/cmms.sqlite
